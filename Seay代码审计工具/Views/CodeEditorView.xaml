<UserControl x:Class="Seay代码审计工具.Views.CodeEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Seay代码审计工具.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>

        <controls:TextEditorHost x:Name="editorHost" Grid.Column="0"/>

        <GridSplitter Grid.Column="1" Width="3" 
                      Background="{DynamicResource BorderBrush}"
                      HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

        <Grid Grid.Column="2" Background="{DynamicResource BgLightBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="8,4" Background="{DynamicResource ControlBrush}">
                <TextBlock Text="函数/变量" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextDimBrush}"/>
            </Border>
            <ListBox x:Name="lboxSymbols" Grid.Row="1" 
                     Background="Transparent" BorderThickness="0"
                     Foreground="{DynamicResource TextBrush}" FontSize="12"
                     SelectionChanged="lboxSymbols_SelectionChanged"
                     MouseDoubleClick="lboxSymbols_DoubleClick"/>

            <Border Grid.Row="2" Padding="8,4" Background="{DynamicResource ControlBrush}">
                <TextBlock Text="引用详情" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextDimBrush}"/>
            </Border>
            <ListBox x:Name="lboxReferences" Grid.Row="3"
                     Background="Transparent" BorderThickness="0"
                     Foreground="{DynamicResource TextBrush}" FontSize="12"
                     MouseDoubleClick="lboxReferences_DoubleClick"/>
        </Grid>

        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="全文追踪" Click="Menu_TraceAll_Click"/>
                <MenuItem Header="定位函数" Click="Menu_LocateFunc_Click"/>
                <MenuItem Header="全局搜索" Click="Menu_GlobalSearch_Click"/>
                <Separator/>
                <MenuItem Header="调试选中" Click="Menu_DebugSelected_Click"/>
                <Separator/>
                <MenuItem Header="保存" Click="Menu_Save_Click"/>
                <MenuItem Header="复制路径" Click="Menu_CopyPath_Click"/>
            </ContextMenu>
        </Grid.ContextMenu>
    </Grid>
</UserControl>
