<UserControl x:Class="Seay代码审计工具.Views.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 功能条 -->
        <Border Grid.Row="0" Background="{DynamicResource BgLightBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="8,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="rbAutoAudit" Content="自动审计" GroupName="AuditMode"
                                 IsChecked="True" Foreground="{DynamicResource TextBrush}"
                                 FontSize="12" Margin="0,0,12,0" Checked="AuditMode_Changed"/>
                    <RadioButton x:Name="rbInfoLeak" Content="信息泄露" GroupName="AuditMode"
                                 Foreground="{DynamicResource TextBrush}"
                                 FontSize="12" Checked="AuditMode_Changed"/>
                </StackPanel>

                <StackPanel x:Name="spInfoLeakOptions" Grid.Column="1" Orientation="Horizontal"
                            Visibility="Collapsed" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="URL" FontSize="12" Foreground="{DynamicResource TextDimBrush}"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="txtUrl" Width="140" Height="22" FontSize="12"
                             VerticalContentAlignment="Center"
                             Background="{DynamicResource ControlLightBrush}"
                             Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource BorderBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="Cookie" FontSize="12" Foreground="{DynamicResource TextDimBrush}"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="txtCookie" Width="100" Height="22" FontSize="12"
                             VerticalContentAlignment="Center"
                             Background="{DynamicResource ControlLightBrush}"
                             Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                    <Button x:Name="btnStart" Content="开始审计" Width="70" Height="26" FontSize="12"
                            Padding="8,2" Style="{DynamicResource PrimaryButtonStyle}"
                            Click="btnStart_Click" Margin="0,0,6,0"/>
                    <Button x:Name="btnStop" Content="停止" Width="46" Height="26" FontSize="12"
                            Padding="6,2" Style="{DynamicResource SecondaryButtonStyle}"
                            Click="btnStop_Click" Margin="0,0,6,0"/>
                    <Button x:Name="btnReport" Content="生成报告" Width="66" Height="26" FontSize="12"
                            Padding="6,2" Style="{DynamicResource SecondaryButtonStyle}"
                            Click="btnReport_Click"/>
                </StackPanel>

                <ProgressBar x:Name="pgbScan" Grid.Column="3" Width="110" Height="12"
                             Margin="10,0,0,0" VerticalAlignment="Center"
                             Background="{DynamicResource ControlBrush}"
                             Foreground="{DynamicResource AccentBrush}"
                             BorderThickness="0"/>

                <TextBlock x:Name="txtStatus" Grid.Column="4" FontSize="12"
                           Foreground="{DynamicResource TextDimBrush}"
                           VerticalAlignment="Center" Margin="10,0,0,0"
                           TextTrimming="CharacterEllipsis" Text="就绪"/>

                <Button x:Name="btnResultsToggle" Grid.Column="5" Content="结果 0"
                        Width="62" Height="26" FontSize="12" Padding="6,2"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        VerticalAlignment="Center" Margin="10,0,0,0"
                        Click="btnResultsToggle_Click"/>
            </Grid>
        </Border>

        <!-- 结果面板（可折叠） -->
        <Border x:Name="spResults" Grid.Row="1" Height="220" Visibility="Collapsed"
                Background="{DynamicResource ControlBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListView x:Name="lvResults" Grid.Row="0"
                          Background="Transparent"
                          Foreground="{DynamicResource TextBrush}"
                          BorderThickness="0" FontSize="12"
                          MouseDoubleClick="lvResults_DoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="ID" Width="40" DisplayMemberBinding="{Binding Id}"/>
                            <GridViewColumn Header="漏洞类型" Width="160" DisplayMemberBinding="{Binding BugType}"/>
                            <GridViewColumn Header="文件" Width="250" DisplayMemberBinding="{Binding FilePath}"/>
                            <GridViewColumn Header="代码详情" Width="500" DisplayMemberBinding="{Binding CodeDetail}"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <Grid Grid.Row="1" Background="{DynamicResource BgLightBrush}">
                    <TextBlock x:Name="txtResultCount" FontSize="11" Margin="10,3"
                               Foreground="{DynamicResource TextDimBrush}"
                               Text="共 0 条结果" IsHitTestVisible="False"/>
                    <Thumb x:Name="resultsResizeThumb" Cursor="SizeNS"
                           DragDelta="ResultsResizeThumb_DragDelta">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border Background="Transparent"/>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
