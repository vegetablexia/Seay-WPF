<UserControl x:Class="Seay代码审计工具.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <TabControl x:Name="tabTools" Style="{DynamicResource DarkTabControlStyle}"
                    Background="Transparent" BorderThickness="0">
            <TabItem Header="PHP调试">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="80"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition x:Name="phpResultsRow" Height="150" MinHeight="60"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Padding="8,4" Background="{DynamicResource ControlBrush}">
                            <TextBlock Text="PHP 代码" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextDimBrush}"/>
                        </Border>
                        <TextBox x:Name="txtPhpCode" Grid.Row="1"
                                 AcceptsReturn="True" AcceptsTab="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="13"
                                 Style="{DynamicResource DarkTextBoxStyle}"
                                 Background="{DynamicResource BgBrush}" Padding="8"/>
                    </Grid>

                    <Border Grid.Row="1" Padding="8,6" Background="{DynamicResource BgLightBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btnRunPhp" Content="执行" Width="80" Height="28"
                                    Style="{DynamicResource PrimaryButtonStyle}" Padding="10,3"
                                    Click="btnRunPhp_Click" Margin="0,0,8,0"/>
                            <Button x:Name="btnClearPhp" Content="清空" Width="60" Height="28"
                                    Style="{DynamicResource SecondaryButtonStyle}" Padding="10,3"
                                    Click="btnClearPhp_Click"/>
                        </StackPanel>
                    </Border>

                    <Thumb x:Name="phpResultsResizeThumb" Grid.Row="2" Height="4" Cursor="SizeNS"
                           DragDelta="PhpResultsResizeThumb_DragDelta">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border x:Name="bd" Background="Transparent"/>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource BorderBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>

                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Padding="8,4" Background="{DynamicResource ControlBrush}">
                            <TextBlock Text="执行结果" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextDimBrush}"/>
                        </Border>
                        <TextBox x:Name="txtPhpResult" Grid.Row="1"
                                 IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="13"
                                 Style="{DynamicResource DarkTextBoxStyle}"
                                 Background="{DynamicResource BgBrush}" Padding="8"/>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="正则/编码">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="8,6" Background="{DynamicResource ControlBrush}">
                        <StackPanel>
                            <TextBlock Text="正则匹配" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="正则表达式"
                                           FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,2"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="选项"
                                           FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="8,0,0,2"/>
                                <TextBox x:Name="txtRegexPattern" Grid.Row="1" Grid.Column="0" Height="28"
                                         FontSize="13" FontFamily="Consolas"
                                         Style="{DynamicResource DarkTextBoxStyle}"
                                         TextChanged="txtRegexPattern_TextChanged"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                    <CheckBox x:Name="chkRegexIgnoreCase" Content="忽略大小写"
                                              Style="{DynamicResource DarkCheckBoxStyle}" FontSize="11"
                                              Margin="0,0,8,0" VerticalAlignment="Center"
                                              Checked="RegexOption_Changed" Unchecked="RegexOption_Changed"/>
                                    <CheckBox x:Name="chkRegexMultiline" Content="多行"
                                              Style="{DynamicResource DarkCheckBoxStyle}" FontSize="11"
                                              VerticalAlignment="Center"
                                              Checked="RegexOption_Changed" Unchecked="RegexOption_Changed"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Padding="8,4" Background="{DynamicResource BgLightBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                        <TextBlock Text="匹配内容" FontSize="11" Foreground="{DynamicResource TextDimBrush}"/>
                    </Border>

                    <TextBox x:Name="txtRegexInput" Grid.Row="2"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="13"
                             Style="{DynamicResource DarkTextBoxStyle}"
                             Background="{DynamicResource BgBrush}" Padding="8"
                             TextChanged="txtRegexInput_TextChanged"/>

                    <Border Grid.Row="3" Padding="8,4" Background="{DynamicResource BgLightBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                        <TextBlock Text="匹配结果" FontSize="11" Foreground="{DynamicResource TextDimBrush}"/>
                    </Border>

                    <ListView x:Name="lvRegexResults" Grid.Row="4"
                              Background="{DynamicResource ControlBrush}"
                              Foreground="{DynamicResource TextBrush}"
                              BorderThickness="0" FontSize="12">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="序号" Width="50" DisplayMemberBinding="{Binding Index}"/>
                                <GridViewColumn Header="匹配内容" Width="500" DisplayMemberBinding="{Binding Value}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>

            <TabItem Header="编解码">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="8,6" Background="{DynamicResource ControlBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="编码类型" FontSize="11" Foreground="{DynamicResource TextDimBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="cmbEncodeType" Width="120" Height="28"
                                      Style="{DynamicResource DarkComboBoxStyle}"
                                      SelectionChanged="cmbEncodeType_SelectionChanged">
                                <ComboBoxItem Content="URL" IsSelected="True"/>
                                <ComboBoxItem Content="Base64"/>
                                <ComboBoxItem Content="Hex"/>
                                <ComboBoxItem Content="MD5"/>
                                <ComboBoxItem Content="ASCII"/>
                                <ComboBoxItem Content="Unicode"/>
                            </ComboBox>
                            <Button x:Name="btnEncode" Content="编码" Width="60" Height="28"
                                    Style="{DynamicResource PrimaryButtonStyle}" Padding="10,3"
                                    Click="btnEncode_Click" Margin="12,0,4,0"/>
                            <Button x:Name="btnDecode" Content="解码" Width="60" Height="28"
                                    Style="{DynamicResource SecondaryButtonStyle}" Padding="10,3"
                                    Click="btnDecode_Click" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Padding="8,4" Background="{DynamicResource BgLightBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                        <TextBlock Text="输入" FontSize="11" Foreground="{DynamicResource TextDimBrush}"/>
                    </Border>

                    <TextBox x:Name="txtEncodeInput" Grid.Row="2"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="13"
                             Style="{DynamicResource DarkTextBoxStyle}"
                             Background="{DynamicResource BgBrush}" Padding="8"/>

                    <Border Grid.Row="3" Padding="8,4" Background="{DynamicResource BgLightBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                        <TextBlock Text="输出" FontSize="11" Foreground="{DynamicResource TextDimBrush}"/>
                    </Border>

                    <TextBox x:Name="txtEncodeOutput" Grid.Row="4"
                             IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="13"
                             Style="{DynamicResource DarkTextBoxStyle}"
                             Background="{DynamicResource BgBrush}" Padding="8"/>
                </Grid>
            </TabItem>

            <TabItem Header="临时记录">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="8,6" Background="{DynamicResource ControlBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btnSaveNote" Content="保存" Width="60" Height="28"
                                    Style="{DynamicResource PrimaryButtonStyle}" Padding="10,3"
                                    Click="btnSaveNote_Click" Margin="0,0,4,0"/>
                            <Button x:Name="btnLoadNote" Content="加载" Width="60" Height="28"
                                    Style="{DynamicResource SecondaryButtonStyle}" Padding="10,3"
                                    Click="btnLoadNote_Click"/>
                        </StackPanel>
                    </Border>

                    <TextBox x:Name="txtTempNote" Grid.Row="1"
                             AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="13"
                             Style="{DynamicResource DarkTextBoxStyle}"
                             Background="{DynamicResource BgBrush}" Padding="8"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
