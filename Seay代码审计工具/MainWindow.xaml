<Window x:Class="Seay代码审计工具.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Seay代码审计工具.Controls"
        xmlns:views="clr-namespace:Seay代码审计工具.Views"
        Title="Seay源代码审计系统" 
        Height="750" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource BgBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        MinWidth="800" MinHeight="600">

    <Border Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <controls:CustomTitleBar x:Name="titleBar" Grid.Row="0"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <controls:NavSidebar x:Name="navSidebar" Grid.Column="0" NavigationChanged="NavSidebar_NavigationChanged"/>

                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="sidePanelColumn" Width="250"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="sidePanelBorder" Grid.Column="0" 
                            Background="{DynamicResource BgLightBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                        <Grid x:Name="sidePanelHost"/>
                    </Border>

                    <GridSplitter x:Name="sideSplitter" Grid.Column="1" Width="3"
                                  Background="{DynamicResource BorderBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                  ResizeBehavior="PreviousAndNext"/>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <views:AuditView x:Name="auditPanel" Grid.Row="0" Visibility="Collapsed"/>

                        <Grid x:Name="mainContentHost" Grid.Row="1"/>
                    </Grid>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Background="{DynamicResource AccentBrush}" Height="24">
                <Grid Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="txtStatus" Grid.Column="0" Foreground="White" FontSize="11" 
                               VerticalAlignment="Center" Text="就绪"/>
                    <TextBlock x:Name="txtEncoding" Grid.Column="1" Foreground="White" FontSize="11" 
                               VerticalAlignment="Center" Margin="10,0" Text="UTF-8"/>
                    <TextBlock x:Name="txtProjectPath" Grid.Column="2" Foreground="White" FontSize="11" 
                               VerticalAlignment="Center" Text=""/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
