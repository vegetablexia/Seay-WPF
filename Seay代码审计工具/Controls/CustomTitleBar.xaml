<UserControl x:Class="Seay代码审计工具.Controls.CustomTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource BgBrush}" Height="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
            <Image Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}" 
                   Width="16" Height="16" Margin="0,0,8,0"/>
            <TextBlock Text="Seay源代码审计系统" Foreground="{DynamicResource TextDimBrush}" 
                       FontSize="12" VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Column="1" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <TextBlock x:Name="txtTitle" Text="" Foreground="{DynamicResource TextDimBrush}" 
                       FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>

        <StackPanel Grid.Column="2" Orientation="Horizontal"
                    WindowChrome.IsHitTestVisibleInChrome="True">
            <Button x:Name="btnMin" Click="btnMin_Click" Style="{DynamicResource TitleBarButtonStyle}"
                    ToolTip="最小化">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE921;" FontSize="10"
                           Foreground="{DynamicResource TextBrush}"/>
            </Button>
            <Button x:Name="btnMax" Click="btnMax_Click" Style="{DynamicResource TitleBarButtonStyle}"
                    ToolTip="最大化">
                <TextBlock x:Name="maxIcon" FontFamily="Segoe MDL2 Assets" Text="&#xE922;" FontSize="10"
                           Foreground="{DynamicResource TextBrush}"/>
            </Button>
            <Button x:Name="btnClose" Click="btnClose_Click" Style="{DynamicResource TitleBarCloseButtonStyle}"
                    ToolTip="关闭">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8BB;" FontSize="10"
                           Foreground="{DynamicResource TextBrush}"/>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
