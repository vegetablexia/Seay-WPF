<UserControl x:Class="Seay代码审计工具.Controls.NavSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="48">
    <Grid Background="{DynamicResource BgLightBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,4,0,0">
            <RadioButton x:Name="navFiles" GroupName="Nav" IsChecked="True"
                         Style="{DynamicResource NavButtonStyle}" ToolTip="文件浏览 / 代码审计" Tag="Files"
                         Checked="NavButton_Checked">
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE838;"/>
            </RadioButton>

            <RadioButton x:Name="navSearch" GroupName="Nav"
                         Style="{DynamicResource NavButtonStyle}" ToolTip="全局搜索" Tag="Search"
                         Checked="NavButton_Checked">
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE721;"/>
            </RadioButton>

            <RadioButton x:Name="navTools" GroupName="Nav"
                         Style="{DynamicResource NavButtonStyle}" ToolTip="工具箱" Tag="Tools"
                         Checked="NavButton_Checked">
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE90F;"/>
            </RadioButton>
        </StackPanel>
    </Grid>
</UserControl>
